var rt_seed interger = 20230426;

rt_random01 : dos() {
    rt_seed = (rt_seed * 48271) %% 2147483647;
    return (rt_seed - 1) / 2147483647.0;
}

rt_random : dos(dos low, dos high) {
    return low + (high - low) * rt_random01();
}

rt_sin : dos(dos x) {
    var turns interger = x / 6.283185307179586;
    var r dos = x - turns * 6.283185307179586;
    var term dos = r;
    var sum dos = r;
    var n interger = 1;
    while (n < 16) {
        term = (0.0 - term) * r * r / ((2 * n) * (2 * n + 1));
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

rt_cos : dos(dos x) {
    var turns interger = x / 6.283185307179586;
    var r dos = x - turns * 6.283185307179586;
    var term dos = 1.0;
    var sum dos = 1.0;
    var n interger = 1;
    while (n < 16) {
        term = (0.0 - term) * r * r / ((2 * n - 1) * (2 * n));
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

rt_ln : dos(dos x) {
    var k interger = 0;
    var m dos = x;
    while (m > 1.5 & k < 1100) {
        m = m / 2.0;
        k = k + 1;
    }
    while (m < 0.75 & k > -1100) {
        m = m * 2.0;
        k = k - 1;
    }
    var s dos = (m - 1.0) / (m + 1.0);
    var s2 dos = s * s;
    var term dos = s;
    var sum dos = 0.0;
    var n interger = 0;
    while (n < 20) {
        sum = sum + term / (2 * n + 1);
        term = term * s2;
        n = n + 1;
    }
    return 2.0 * sum + k * 0.6931471805599453;
}

rt_exp : dos(dos x) {
    var k interger = x / 0.6931471805599453;
    if (k > 1100) {
        k = 1100;
    }
    if (k < -1100) {
        k = -1100;
    }
    var r dos = x - k * 0.6931471805599453;
    var term dos = 1.0;
    var sum dos = 1.0;
    var n interger = 1;
    while (n < 22) {
        term = term * r / n;
        sum = sum + term;
        n = n + 1;
    }
    while (k > 0) {
        sum = sum * 2.0;
        k = k - 1;
    }
    while (k < 0) {
        sum = sum / 2.0;
        k = k + 1;
    }
    return sum;
}

rt_pow : dos(dos x, dos y) {
    if (y == 0.0) {
        return 1.0;
    }
    if (y == 0.5) {
        return rt_fsqrt(x);
    }
    var whole interger = y;
    if (whole == y) {
        var result dos = 1.0;
        var count interger = whole;
        if (count < 0) {
            count = 0 - count;
        }
        while (count > 0) {
            result = result * x;
            count = count - 1;
        }
        if (whole < 0) {
            return 1.0 / result;
        }
        return result;
    }
    if (x <= 0.0) {
        return 0.0;
    }
    return rt_exp(y * rt_ln(x));
}

rt_mat_scale : matrix(matrix m, dos s, interger op, interger scalarFirst) {
    var r interger = rt_rows(m);
    var c interger = rt_cols(m);
    collection result matrix[[]] = c`r;
    var i interger = 0;
    while (i < r) {
        var j interger = 0;
        while (j < c) {
            var cell dos = get m[[i,j]];
            var left dos = cell;
            var right dos = s;
            if (scalarFirst == 1) {
                left = s;
                right = cell;
            }
            if (op == 0) {
                result[[i,j]] = left + right;
            } elseif (op == 1) {
                result[[i,j]] = left - right;
            } elseif (op == 2) {
                result[[i,j]] = left * right;
            } else {
                result[[i,j]] = left / right;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

rt_mat_dot : matrix(matrix a, matrix b) {
    var ra interger = rt_rows(a);
    var ca interger = rt_cols(a);
    var rb interger = rt_rows(b);
    var cb interger = rt_cols(b);
    var na interger = ra * ca;
    var nb interger = rb * cb;
    var vecA interger = 0;
    var vecB interger = 0;
    if (ra == 1 | ca == 1) {
        vecA = 1;
    }
    if (rb == 1 | cb == 1) {
        vecB = 1;
    }
    if (vecA == 1 & vecB == 1 & na == nb) {
        var sum dos = 0.0;
        var i interger = 0;
        while (i < na) {
            sum = sum + get a[[i / ca, i %% ca]] * get b[[i / cb, i %% cb]];
            i = i + 1;
        }
        collection one matrix[[]] = 1`1;
        one[[0,0]] = sum;
        return one;
    }
    return a * b;
}

rt_mat_eq : interger(matrix a, matrix b) {
    var r interger = rt_rows(a);
    var c interger = rt_cols(a);
    if (r == rt_rows(b)) {
        if (c == rt_cols(b)) {
            var i interger = 0;
            while (i < r) {
                var j interger = 0;
                while (j < c) {
                    var gap dos = get a[[i,j]] - get b[[i,j]];
                    if (gap > 0.0) {
                        return 0;
                    }
                    if (gap < 0.0) {
                        return 0;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            return 1;
        }
    }
    return 0;
}
