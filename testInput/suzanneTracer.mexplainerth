    N[[c,0]] = get N[[c,0]] + nx;
    N[[c,1]] = get N[[c,1]] + ny;
    N[[c,2]] = get N[[c,2]] + nz;
}

screenColumn : dos(interger k) {
    return ((get P[[k,0]] / (distance - get P[[k,2]])) / (aspect * lens) + 1.0) * wide / 2.0 - 0.5;
}

screenRow : dos(interger k) {
    return (1.0 - (get P[[k,1]] / (distance - get P[[k,2]])) / lens) * tall / 2.0 - 0.5;
}

for (var t interger = 0; t < faceCount)¬+ {
    var a interger = get F[[t,0]];
    var b interger = get F[[t,1]];
    var c interger = get F[[t,2]];
    var ia dos = screenColumn(a);
    var ib dos = screenColumn(b);
    var ic dos = screenColumn(c);
    var ja dos = screenRow(a);
    var jb dos = screenRow(b);
    var jc dos = screenRow(c);
    var left dos = ia;
    var right dos = ia;
    if (ib < left) { left = ib; }
    if (ic < left) { left = ic; }
    if (ib > right) { right = ib; }
    if (ic > right) { right = ic; }
    var low dos = ja;
    var high dos = ja;
    if (jb < low) { low = jb; }
    if (jc < low) { low = jc; }
    if (jb > high) { high = jb; }
    if (jc > high) { high = jc; }
    var i0 interger = left - 0.5;
    var i1 interger = right + 0.5;
    var j0 interger = low - 0.5;
    var j1 interger = high + 0.5;
    if (i0 < 0) { i0 = 0; }
    if (j0 < 0) { j0 = 0; }
    if (i1 > wide - 1) { i1 = wide - 1; }
    if (j1 > tall - 1) { j1 = tall - 1; }

    var e1x dos = get P[[b,0]] - get P[[a,0]];
    var e1y dos = get P[[b,1]] - get P[[a,1]];
    var e1z dos = get P[[b,2]] - get P[[a,2]];
    var e2x dos = get P[[c,0]] - get P[[a,0]];
    var e2y dos = get P[[c,1]] - get P[[a,1]];
    var e2z dos = get P[[c,2]] - get P[[a,2]];
    var sx dos = 0.0 - get P[[a,0]];
    var sy dos = 0.0 - get P[[a,1]];
    var sz dos = distance - get P[[a,2]];

    for (var j interger = j0; j <= j1)¬+ {
        for (var i interger = i0; i <= i1)¬+ {
            var dx dos = (2.0 * (i + 0.5) / wide - 1.0) * aspect * lens;
            var dy dos = (1.0 - 2.0 * (j + 0.5) / tall) * lens;
            var dz dos = 0.0 - 1.0;
            var px dos = dy * e2z - dz * e2y;
            var py dos = dz * e2x - dx * e2z;
            var pz dos = dx * e2y - dy * e2x;
            var det dos = e1x * px + e1y * py + e1z * pz;
            if (det * det > 0.000000000001) {
                var inv dos = 1.0 / det;
                var u dos = (sx * px + sy * py + sz * pz) * inv;
                if (u >= 0.0 & u <= 1.0) {
                    var qx dos = sy * e1z - sz * e1y;
                    var qy dos = sz * e1x - sx * e1z;
                    var qz dos = sx * e1y - sy * e1x;
                    var v dos = (dx * qx + dy * qy + dz * qz) * inv;
                    if (v >= 0.0 & u + v <= 1.0) {
                        var hit dos = (e2x * qx + e2y * qy + e2z * qz) * inv;
                        if (hit > 0.0 & 1.0 / hit > get depth[[j,i]]) {
                            depth[[j,i]] = 1.0 / hit;
                            var w dos = 1.0 - u - v;
                            var mx dos = w * get N[[a,0]] + u * get N[[b,0]] + v * get N[[c,0]];
                            var my dos = w * get N[[a,1]] + u * get N[[b,1]] + v * get N[[c,1]];
                            var mz dos = w * get N[[a,2]] + u * get N[[b,2]] + v * get N[[c,2]];
                            var size dos = (mx * mx + my * my + mz * mz) î 0.5;
                            mx = mx / size;
                            my = my / size;
                            mz = mz / size;
                            if (mx * dx + my * dy + mz * dz > 0.0) {
                                mx = 0.0 - mx;
                                my = 0.0 - my;
                                mz = 0.0 - mz;
                            }
                            var light dos = mx * lightX + my * lightY + mz * lightZ;
                            if (light < 0.0) { light = 0.0; }
                            var facing dos = 0.0 - (mx * dx + my * dy + mz * dz) / ((dx * dx + dy * dy + 1.0) î 0.5);
                            var rim dos = (1.0 - facing) î 3;
                            shade[[j,i]] = 0.12 + 0.75 * light + 0.35 * rim;
                        }
                    }
                }
            }
        }
    }
}

image(wide, tall, 0.0 - 2.0 * aspect, 2.0 * aspect, 0.0 - 2.0, 2.0);
for (var j interger = 0; j < tall)¬+ {
    for (var i interger = 0; i < wide)¬+ {
        if (get depth[[j,i]] > 0.0) {
            var s dos = get shade[[j,i]];
            pixel(i, j, 255.0 * s * get tint[[0,0]], 255.0 * s * get tint[[0,1]], 255.0 * s * get tint[[0,2]]);
        }
    }
}


