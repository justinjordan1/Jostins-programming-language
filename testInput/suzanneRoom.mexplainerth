rand : dos() {
    var product dos = seed * 16807.0;
    var whole interger = product / 2147483647.0 - 0.5;
    seed = product - whole * 2147483647.0;
    return seed / 2147483647.0;
}

collection N matrix[[]] = 3`vertexCount;
for (var t interger = 0; t < faceCount)¬+ {
    var a interger = get F[[t,0]];
    var b interger = get F[[t,1]];
    var c interger = get F[[t,2]];
    var ux dos = get V[[b,0]] - get V[[a,0]];
    var uy dos = get V[[b,1]] - get V[[a,1]];
    var uz dos = get V[[b,2]] - get V[[a,2]];
    var vx dos = get V[[c,0]] - get V[[a,0]];
    var vy dos = get V[[c,1]] - get V[[a,1]];
    var vz dos = get V[[c,2]] - get V[[a,2]];
    var nx dos = uy * vz - uz * vy;
    var ny dos = uz * vx - ux * vz;
    var nz dos = ux * vy - uy * vx;
    N[[a,0]] = get N[[a,0]] + nx;
    N[[a,1]] = get N[[a,1]] + ny;
    N[[a,2]] = get N[[a,2]] + nz;
    N[[b,0]] = get N[[b,0]] + nx;
    N[[b,1]] = get N[[b,1]] + ny;
    N[[b,2]] = get N[[b,2]] + nz;
    N[[c,0]] = get N[[c,0]] + nx;
    N[[c,1]] = get N[[c,1]] + ny;
    N[[c,2]] = get N[[c,2]] + nz;
}

collection stack matrix[[]] = 64`1;
var hitKind interger = 0;
var hitWall interger = 0;
var hitT dos = 0.0;
var hitNX dos = 0.0;
var hitNY dos = 0.0;
var hitNZ dos = 0.0;
var hitGX dos = 0.0;
var hitGY dos = 0.0;
var hitGZ dos = 0.0;
var hitFace interger = 0 - 1;
var skipFace interger = 0 - 1;

hitMonkey : dos(dos ox, dos oy, dos oz, dos dx, dos dy, dos dz, dos best) {
    var px dos = ox - offX;
    var py dos = oy - offY;
    var pz dos = oz - offZ;
    var mox dos = px * get R[[0,0]] + py * get R[[0,1]] + pz * get R[[0,2]];
    var moy dos = px * get R[[1,0]] + py * get R[[1,1]] + pz * get R[[1,2]];
    var moz dos = px * get R[[2,0]] + py * get R[[2,1]] + pz * get R[[2,2]];
    var mdx dos = dx * get R[[0,0]] + dy * get R[[0,1]] + dz * get R[[0,2]];
    var mdy dos = dx * get R[[1,0]] + dy * get R[[1,1]] + dz * get R[[1,2]];
    var mdz dos = dx * get R[[2,0]] + dy * get R[[2,1]] + dz * get R[[2,2]];
    var ix dos = 1000000000000.0;
    var iy dos = 1000000000000.0;
    var iz dos = 1000000000000.0;
    if (mdx * mdx > 0.0) { ix = 1.0 / mdx; }
    if (mdy * mdy > 0.0) { iy = 1.0 / mdy; }
    if (mdz * mdz > 0.0) { iz = 1.0 / mdz; }

    var face interger = 0 - 1;
    var hitU dos = 0.0;
    var hitV dos = 0.0;
    stack[[0,0]] = 0;
    var top interger = 1;
    while (top > 0) {
        top = top - 1;
        var node interger = get stack[[0,top]];
        var x1 dos = (get B[[node,0]] - mox) * ix;
        var x2 dos = (get B[[node,3]] - mox) * ix;
        var y1 dos = (get B[[node,1]] - moy) * iy;
        var y2 dos = (get B[[node,4]] - moy) * iy;
        var z1 dos = (get B[[node,2]] - moz) * iz;
        var z2 dos = (get B[[node,5]] - moz) * iz;
        var enter dos = x1;
        var leave dos = x2;
        if (x2 < x1) {
            enter = x2;
            leave = x1;
        }
        if (y1 < y2) {
            if (y1 > enter) { enter = y1; }
            if (y2 < leave) { leave = y2; }
        } else {
            if (y2 > enter) { enter = y2; }
            if (y1 < leave) { leave = y1; }
        }
        if (z1 < z2) {
            if (z1 > enter) { enter = z1; }
            if (z2 < leave) { leave = z2; }
        } else {
            if (z2 > enter) { enter = z2; }
            if (z1 < leave) { leave = z1; }
        }
        if (leave >= enter & leave > 0.0 & enter < best) {
            var count interger = get B[[node,7]];
            if (count > 0) {
                var first interger = get B[[node,6]];
                for (var f interger = first; f < first + count)¬+ {
                    var a interger = get F[[f,0]];
                    var b interger = get F[[f,1]];
                    var c interger = get F[[f,2]];
                    var e1x dos = get V[[b,0]] - get V[[a,0]];
                    var e1y dos = get V[[b,1]] - get V[[a,1]];
                    var e1z dos = get V[[b,2]] - get V[[a,2]];
                    var e2x dos = get V[[c,0]] - get V[[a,0]];
                    var e2y dos = get V[[c,1]] - get V[[a,1]];
                    var e2z dos = get V[[c,2]] - get V[[a,2]];
                    var qx dos = mdy * e2z - mdz * e2y;
                    var qy dos = mdz * e2x - mdx * e2z;
                    var qz dos = mdx * e2y - mdy * e2x;
                    var det dos = e1x * qx + e1y * qy + e1z * qz;
                    if (det * det > 0.000000000001) {
                        var inv dos = 1.0 / det;
                        var sx dos = mox - get V[[a,0]];
                        var sy dos = moy - get V[[a,1]];
                        var sz dos = moz - get V[[a,2]];
                        var u dos = (sx * qx + sy * qy + sz * qz) * inv;
                        if (u >= 0.0 & u <= 1.0) {
                            var rx dos = sy * e1z - sz * e1y;
                            var ry dos = sz * e1x - sx * e1z;
                            var rz dos = sx * e1y - sy * e1x;
                            var v dos = (mdx * rx + mdy * ry + mdz * rz) * inv;
                            if (v >= 0.0 & u + v <= 1.0) {
                                var along dos = (e2x * rx + e2y * ry + e2z * rz) * inv;
                                if (along > 0.0001 & along < best & f =/= skipFace) {
                                    best = along;
                                    face = f;
                                    hitU = u;
                                    hitV = v;
                                }
                            }
                        }
                    }
                }
            } else {
                stack[[0,top]] = get B[[node,6]];
                stack[[0,top + 1]] = get B[[node,8]];
                top = top + 2;
            }
        }
    }

    if (face >= 0) {
        var a interger = get F[[face,0]];
        var b interger = get F[[face,1]];
        var c interger = get F[[face,2]];
        var w dos = 1.0 - hitU - hitV;
        var mx dos = w * get N[[a,0]] + hitU * get N[[b,0]] + hitV * get N[[c,0]];
        var my dos = w * get N[[a,1]] + hitU * get N[[b,1]] + hitV * get N[[c,1]];
        var mz dos = w * get N[[a,2]] + hitU * get N[[b,2]] + hitV * get N[[c,2]];
        var wx dos = mx * get R[[0,0]] + my * get R[[1,0]] + mz * get R[[2,0]];
        var wy dos = mx * get R[[0,1]] + my * get R[[1,1]] + mz * get R[[2,1]];
        var wz dos = mx * get R[[0,2]] + my * get R[[1,2]] + mz * get R[[2,2]];
        var size dos = (wx * wx + wy * wy + wz * wz) î 0.5;
        hitNX = wx / size;
        hitNY = wy / size;
        hitNZ = wz / size;
        var e1x dos = get V[[b,0]] - get V[[a,0]];
        var e1y dos = get V[[b,1]] - get V[[a,1]];
        var e1z dos = get V[[b,2]] - get V[[a,2]];
        var e2x dos = get V[[c,0]] - get V[[a,0]];
        var e2y dos = get V[[c,1]] - get V[[a,1]];
        var e2z dos = get V[[c,2]] - get V[[a,2]];
        var gx dos = e1y * e2z - e1z * e2y;
        var gy dos = e1z * e2x - e1x * e2z;
        var gz dos = e1x * e2y - e1y * e2x;
        var hx dos = gx * get R[[0,0]] + gy * get R[[1,0]] + gz * get R[[2,0]];
        var hy dos = gx * get R[[0,1]] + gy * get R[[1,1]] + gz * get R[[2,1]];
        var hz dos = gx * get R[[0,2]] + gy * get R[[1,2]] + gz * get R[[2,2]];
        var gsize dos = (hx * hx + hy * hy + hz * hz) î 0.5;
        hitGX = hx / gsize;
        hitGY = hy / gsize;
        hitGZ = hz / gsize;
        hitFace = face;
        hitKind = 2;
        hitT = best;
    }
    return best;
}

hitScene : interger(dos ox, dos oy, dos oz, dos dx, dos dy, dos dz) {
    var best dos = 1000000.0;
    hitKind = 1;
    hitWall = 0;
    if (dx > 0.0) {
        best = (roomRight - ox) / dx;
        hitWall = 1;
    }
    if (dx < 0.0) {
        best = (roomLeft - ox) / dx;
        hitWall = 0;
    }
    if (dy > 0.0) {
        var up dos = (roomCeiling - oy) / dy;
        if (up < best) {
            best = up;
            hitWall = 3;
        }
    }
    if (dy < 0.0) {
        var down dos = (roomFloor - oy) / dy;
        if (down < best) {
            best = down;
            hitWall = 2;
        }
    }
    if (dz > 0.0) {
        var ahead dos = (roomFront - oz) / dz;
        if (ahead < best) {
            best = ahead;
            hitWall = 5;
        }
    }
    if (dz < 0.0) {
        var behind dos = (roomBack - oz) / dz;
        if (behind < best) {
            best = behind;
            hitWall = 4;
        }
    }
    hitT = best;
    hitNX = 0.0;
    hitNY = 0.0;
    hitNZ = 0.0;
    if (hitWall == 0) { hitNX = 1.0; }
    if (hitWall == 1) { hitNX = 0.0 - 1.0; }
    if (hitWall == 2) { hitNY = 1.0; }
    if (hitWall == 3) { hitNY = 0.0 - 1.0; }
    if (hitWall == 4) { hitNZ = 1.0; }
    if (hitWall == 5) { hitNZ = 0.0 - 1.0; }
    hitGX = hitNX;
    hitGY = hitNY;
    hitGZ = hitNZ;
    hitFace = 0 - 1;

    var cx dos = ox - lampX;
    var cy dos = oy - lampY;
    var cz dos = oz - lampZ;
    var half dos = cx * dx + cy * dy + cz * dz;
    var gap dos = half * half - (cx * cx + cy * cy + cz * cz - lampSize * lampSize);
    if (gap > 0.0) {
        var near dos = 0.0 - half - (gap î 0.5);
        if (near > 0.0001 & near < hitT) {
            hitT = near;
            hitKind = 3;
        }
    }

    hitMonkey(ox, oy, oz, dx, dy, dz, hitT);
    return hitKind;
}

image(wide, tall, 0.0 - 2.0 * aspect, 2.0 * aspect, 0.0 - 2.0, 2.0);
for (var j interger = 0; j < tall)¬+ {
    for (var i interger = 0; i < wide)¬+ {
        seed = 1.0 + i * 7919.0 + j * 104729.0;
        rand();
        rand();
        var sumR dos = 0.0;
        var sumG dos = 0.0;
        var sumB dos = 0.0;
        for (var sample interger = 0; sample < samples)¬+ {
            var ox dos = camX;
            var oy dos = camY;
            var oz dos = camZ;
            var dx dos = (2.0 * (i + rand()) / wide - 1.0) * aspect * lens;
            var dy dos = (1.0 - 2.0 * (j + rand()) / tall) * lens;
            var dz dos = 0.0 - 1.0;
            var length dos = (dx * dx + dy * dy + dz * dz) î 0.5;
            dx = dx / length;
            dy = dy / length;
            dz = dz / length;
            var colorR dos = 0.0;
            var colorG dos = 0.0;
            var colorB dos = 0.0;
            var weightR dos = 1.0;
            var weightG dos = 1.0;
            var weightB dos = 1.0;
            skipFace = 0 - 1;
            for (var bounce interger = 0; bounce <= bounces)¬+ {
                var kind interger = hitScene(ox, oy, oz, dx, dy, dz);
                skipFace = 0 - 1;
                if (kind == 3) {
                    colorR = colorR + weightR * 1.0;
                    colorG = colorG + weightG * 0.95;
                    colorB = colorB + weightB * 0.85;
                    break;
                }
                var px dos = ox + dx * hitT;
                var py dos = oy + dy * hitT;
                var pz dos = oz + dz * hitT;
                var nx dos = hitNX;
                var ny dos = hitNY;
                var nz dos = hitNZ;
                var gx dos = hitGX;
                var gy dos = hitGY;
                var gz dos = hitGZ;
                var from interger = hitFace;
                if (gx * dx + gy * dy + gz * dz > 0.0) {
                    gx = 0.0 - gx;
                    gy = 0.0 - gy;
                    gz = 0.0 - gz;
                }
                if (nx * gx + ny * gy + nz * gz < 0.0) {
                    nx = 0.0 - nx;
                    ny = 0.0 - ny;
                    nz = 0.0 - nz;
                }
                var albedoR dos = 0.72;
                var albedoG dos = 0.72;
                var albedoB dos = 0.72;
                var mirror dos = 0.0;
                var fuzz dos = 0.0;
                if (kind == 2) {
                    albedoR = get tint[[0,0]];
                    albedoG = get tint[[0,1]];
                    albedoB = get tint[[0,2]];
                    mirror = 0.3;
                    fuzz = 0.08;
                } else {
                    if (hitWall == 0) {
                        albedoR = 0.75;
                        albedoG = 0.22;
                        albedoB = 0.2;
                    }
                    if (hitWall == 1) {
                        albedoR = 0.2;
                        albedoG = 0.42;
                        albedoB = 0.75;
                    }
                    if (hitWall == 2) {
                        var cell interger = (px + 100.0) * 0.8 + 0.5;
                        var other interger = (pz + 100.0) * 0.8 + 0.5;
                        if ((cell + other) %% 2 == 0) {
                            albedoR = 0.82;
                            albedoG = 0.8;
                            albedoB = 0.76;
                        } else {
                            albedoR = 0.3;
                            albedoG = 0.3;
                            albedoB = 0.32;
                        }
                        mirror = 0.22;
                    }
                }

                var shine dos = 0.0;
                for (var ray interger = 0; ray < shadowRays)¬+ {
                    var height dos = 2.0 * rand() - 1.0;
                    var turn dos = 6.283185307179586 * rand();
                    var ring dos = (1.0 - height * height) î 0.5;
                    var qx dos = lampX + lampSize * ring * cos(turn);
                    var qy dos = lampY + lampSize * height;
                    var qz dos = lampZ + lampSize * ring * sin(turn);
                    var lx dos = qx - px;
                    var ly dos = qy - py;
                    var lz dos = qz - pz;
                    var distance dos = (lx * lx + ly * ly + lz * lz) î 0.5;
                    lx = lx / distance;
                    ly = ly / distance;
                    lz = lz / distance;
                    var facing dos = nx * lx + ny * ly + nz * lz;
                    if (facing > 0.0 & gx * lx + gy * ly + gz * lz > 0.0) {
                        skipFace = from;
                        var blocked dos = hitMonkey(px + gx * 0.002, py + gy * 0.002, pz + gz * 0.002, lx, ly, lz, distance - lampSize);
                        skipFace = 0 - 1;
                        if (blocked >= distance - lampSize) {
                            shine = shine + lampPower * facing / (distance * distance);
                        }
                    }
                }
                shine = shine / shadowRays + 0.1;
                var keep dos = 1.0 - mirror;
                colorR = colorR + weightR * keep * albedoR * shine;
                colorG = colorG + weightG * keep * albedoG * shine * 0.97;
                colorB = colorB + weightB * keep * albedoB * shine * 0.92;
                if (mirror == 0.0) {
                    break;
                }
                weightR = weightR * mirror * (0.5 + 0.5 * albedoR);
                weightG = weightG * mirror * (0.5 + 0.5 * albedoG);
                weightB = weightB * mirror * (0.5 + 0.5 * albedoB);
                var dot dos = dx * nx + dy * ny + dz * nz;
                dx = dx - 2.0 * dot * nx + fuzz * (2.0 * rand() - 1.0);
                dy = dy - 2.0 * dot * ny + fuzz * (2.0 * rand() - 1.0);
                dz = dz - 2.0 * dot * nz + fuzz * (2.0 * rand() - 1.0);
                var outward dos = dx * gx + dy * gy + dz * gz;
                if (outward < 0.0) {
                    dx = dx - 2.0 * outward * gx;
                    dy = dy - 2.0 * outward * gy;
                    dz = dz - 2.0 * outward * gz;
                }
                var stretch dos = (dx * dx + dy * dy + dz * dz) î 0.5;
                dx = dx / stretch;
                dy = dy / stretch;
                dz = dz / stretch;
                ox = px + gx * 0.002;
                oy = py + gy * 0.002;
                oz = pz + gz * 0.002;
                skipFace = from;
            }
            sumR = sumR + colorR;
            sumG = sumG + colorG;
            sumB = sumB + colorB;
        }
        sumR = sumR / samples;
        sumG = sumG / samples;
        sumB = sumB / samples;
        if (sumR > 1.0) { sumR = 1.0; }
        if (sumG > 1.0) { sumG = 1.0; }
        if (sumB > 1.0) { sumB = 1.0; }
        pixel(i, j, 255.0 * (sumR î 0.5), 255.0 * (sumG î 0.5), 255.0 * (sumB î 0.5));
    }
}
