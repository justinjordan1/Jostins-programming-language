print("liftoff\n");

class Square {
    var side dos = 0.0;

    init : interger(dos s) {
        this.side = s;
        return 0;
    }

    area : dos() {
        return side * side;
    }

    grow : dos(dos amount) {
        side = side + amount;
        return side;
    }
}

class Circle {
    init : interger(dos r) {
        this.radius = r;
        return 0;
    }

    area : dos() {
        return 3.0 * radius * radius;
    }
}

describe : dos(object shape) {
    return shape.area();
}

var box object = Square(3.0);
var ring object = Circle(1.0);
print(box, " area = ", describe(box), ", ", ring, " area = ", describe(ring), "\n");
box.grow(1.0);
print("after grow, side = ", box.side, ", area = ", box.area(), "\n");
box.side = 10.0;
print("after box.side = 10.0, area = ", box.area(), "\n");

collection shapes object[] = [Square(2.0), Circle(2.0), Square(1.0)];
var totalArea dos = 0.0;
foreach (shape ∆ shapes) {
    totalArea = totalArea + shape.area();
}
print("total area of shapes = ", totalArea, "\n");

collection steps interger<<>> = <<5, 10, 15>>;
var stepTotal interger = 0;
foreach (step ∆ steps) {
    stepTotal = stepTotal + step;
}
print("sum of steps = ", stepTotal, "\n");

collection a matrix[[]] = [[1.0, 2.0]\[3.0, 4.0]];
collection b matrix[[]] = [[0.0, 1.0]\[1.0, 0.0]];
print("a * b = ", a * b, "\n");
print("a + b = ", a + b, "\n");
print("a - b = ", a - b, "\n");
print("a * 2.0 = ", a * 2.0, "\n");
print("10.0 - a = ", 10.0 - a, "\n");
print("a / 4.0 = ", a / 4.0, "\n");
print("a == a is ", a == a, ", a == b is ", a == b, "\n");
print("a[[1,0]] = ", get a[[1,0]], "\n");

collection u matrix[[]] = [[1.0]\[2.0]\[3.0]];
print("u ˚ u = ", u ˚ u, "\n");

var cellTotal dos = 0.0;
foreach (cell ∆ a) {
    cellTotal = cellTotal + cell;
}
print("sum of cells in a = ", cellTotal, "\n");

collection rot matrix[[]] = 2`2;
rot[[0,0]] = 0.0;
rot[[0,1]] = -1.0;
rot[[1,0]] = 1.0;
rot[[1,1]] = 0.0;
collection p matrix[[]] = [[1.0]\[1.0]];
print("rot * p = ", rot * p, "\n");

