fact : interger(interger n) {
    if (n < 2) {
        return 1;
    }
    return n * fact(n - 1);
}

hyp : dos(dos a, dos b) {
    return (a * a) + (b * b);
}

square : dos(interger x) {
    var sq dos = x î 2;
}

