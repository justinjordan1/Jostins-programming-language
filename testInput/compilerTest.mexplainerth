var i interger = 0;
var total interger = 0;
while (i < 100) {
    i = i + 1;
    if (i %% 2 == 0) {
        total = total + i;
    }
    if (i == 10) {
        break;
    }
}
print("sum of evens up to 10 = ", total, "\n");

