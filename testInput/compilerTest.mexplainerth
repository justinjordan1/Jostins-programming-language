fact : interger(interger n) {
    if (n < 2) {
        return 1;
    }
    return n * fact(n - 1);
}

hyp : dos(dos a, dos b) {
    return (a * a) + (b * b);
}

first : interger(interger n) {
    return second(n) + 1;
}

second : interger(interger n) {
    return n * 10;
}

print("2 + 3 * 4 = ", 2 + 3 * 4, "\n");
print("fact(10) = ", fact(10), "\n");
print("hyp(3, 4) = ", hyp(3.0, 4.0), "\n");
print("first(4) = ", first(4), "\n");
print("2 î 10 = ", 2 î 10, "\n");
print("16.0 î 0.5 = ", 16.0 î 0.5, "\n");
print("2.0 î -2 = ", 2.0 î -2, "\n");
print("17 %% 5 = ", 17 %% 5, "\n");
print("7 / 2 = ", 7 / 2, " and 7 / 2.0 = ", 7 / 2.0, "\n");

